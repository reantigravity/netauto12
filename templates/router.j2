{# Cisco IOS dual-stack router configuration.
   Rendered by generate.py from intended/network.yaml.
   target = "pt"  -> Packet Tracer friendly
   target = "lab" -> real IOS / IOS XE with SSH for Netmiko #}
! ===== {{ r.name }} ({{ r.role }}) - generated by netauto, do not edit by hand =====
hostname {{ r.name }}
no ip domain-lookup
ip domain-name {{ defaults.domain_name }}
ipv6 unicast-routing
!
interface Loopback0
 description Router-ID
 ip address {{ r.loopback4.ip }} {{ r.loopback4.netmask }}
 ipv6 address {{ r.loopback6 }}
 ipv6 ospf {{ ospf.process }} area {{ ospf.area }}
!
{% for i in r.interfaces %}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.ipv4_addr }} {{ i.ipv4_mask }}
{% if i.link_local %}
 ipv6 address {{ i.link_local }} link-local
{% endif %}
 ipv6 address {{ i.ipv6 }}
 ipv6 ospf {{ ospf.process }} area {{ ospf.area }}
 no shutdown
!
{% endfor %}
router ospf {{ ospf.process }}
 router-id {{ r.router_id }}
 network {{ r.loopback4.ip }} 0.0.0.0 area {{ ospf.area }}
{% for i in r.interfaces %}
 network {{ i.ipv4_network }} {{ i.ipv4_wildcard }} area {{ ospf.area }}
{% endfor %}
{% for i in r.lan_interfaces %}
 passive-interface {{ i.name }}
{% endfor %}
!
ipv6 router ospf {{ ospf.process }}
 router-id {{ r.router_id }}
{% for i in r.lan_interfaces %}
 passive-interface {{ i.name }}
{% endfor %}
!
{% for s in r.static_routes %}
{% if s.version == 4 %}
ip route {{ s.prefix.network_address }} {{ s.prefix.netmask }} {{ s.next_hop }}
{% elif s.next_hop == "Null0" and not caps.ipv6_null_route %}
! skipped: "ipv6 route {{ s.prefix }} Null0" is not supported on platform "{{ target }}"
{% else %}
ipv6 route {{ s.prefix }} {{ s.next_hop }}
{% endif %}
{% endfor %}
{% if target == "lab" %}
!
! ----- management access for Netmiko (SSH) -----
username {{ mgmt.username }} privilege 15 secret {{ mgmt.secret }}
ip ssh version 2
line vty 0 4
 login local
 transport input ssh
{% endif %}
!
end
